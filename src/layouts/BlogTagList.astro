---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import TagSidebar from '../components/TagSidebar.astro';
import { SITE_TITLE } from '../consts';
import { tagSlug } from '../lib/blog';

interface Props {
	tag: string;
	posts: CollectionEntry<'blog'>[];
	lang: 'en' | 'ko';
	alternatePath?: string;
}

const { tag, posts, lang, alternatePath } = Astro.props;
const isKo = lang === 'ko';
const backHref = isKo ? '/ko/blog' : '/blog';
const backLabel = isKo ? '← 목록으로' : '← Back to blog';
const countLabel = isKo
	? `글 ${posts.length}편`
	: `${posts.length} post${posts.length === 1 ? '' : 's'}`;
const description = isKo
	? `"${tag}" 태그가 붙은 글 ${posts.length}편`
	: `${posts.length} post${posts.length === 1 ? '' : 's'} tagged "${tag}"`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
			title={`#${tag} · ${SITE_TITLE}`}
			description={description}
			alternatePath={alternatePath}
		/>
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href={backHref}>{backLabel}</a>
			<header class="tag-hero">
				<h1><span class="hash" aria-hidden="true">#</span>{tag}</h1>
				<p class="count">{countLabel}</p>
			</header>
			<div class="list-layout">
				<TagSidebar lang={lang} activeSlug={tagSlug(tag)} />
				<PostList posts={posts} lang={lang} />
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* 태그 사이드바가 붙는 목록 페이지만 본문 폭을 넓힌다. */
	main {
		width: min(1020px, calc(100% - 2em));
	}
	.list-layout {
		display: grid;
		grid-template-columns: 200px minmax(0, 1fr);
		gap: 3rem;
	}
	@media (max-width: 880px) {
		.list-layout {
			display: block;
		}
		.list-layout > :global(.tag-sidebar) {
			margin-bottom: 1.75rem;
		}
	}
	.back {
		display: inline-block;
		margin-bottom: 2rem;
		font-size: 0.9rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.back:hover {
		color: var(--accent);
	}
	.tag-hero {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		column-gap: 1rem;
		margin-bottom: 1.5rem;
	}
	.tag-hero h1 {
		margin: 0;
		font-size: clamp(2.2rem, 8vw, 3rem);
		overflow-wrap: anywhere;
	}
	.tag-hero .hash {
		margin-right: 0.08em;
		color: var(--accent);
	}
	.tag-hero .count {
		margin: 0;
		font-size: 0.95rem;
		color: rgb(var(--gray));
	}
</style>
