---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { type PostNav, tagSlug } from '../lib/blog';

type Props = CollectionEntry<'blog'>['data'] & {
	lang?: 'en' | 'ko';
	alternatePath?: string;
	headings?: MarkdownHeading[];
	nav?: PostNav;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	socialImage,
	tags,
	lang = 'en',
	alternatePath,
	headings = [],
	nav,
} = Astro.props;
const backHref = lang === 'ko' ? '/ko/blog' : '/blog';
const backLabel = lang === 'ko' ? '← 목록으로' : '← Back to blog';
const updatedLabel = lang === 'ko' ? '수정됨' : 'Updated';
const tagsLabel = lang === 'ko' ? '태그' : 'Tags';
const seriesLabel = lang === 'ko' ? '시리즈' : 'Series';
const prevLabel = lang === 'ko' ? '← 이전 글' : '← Previous';
const nextLabel = lang === 'ko' ? '다음 글 →' : 'Next →';
const postNavLabel = lang === 'ko' ? '이전/다음 글' : 'Previous and next posts';
const relatedLabel = lang === 'ko' ? '관련 글' : 'Related posts';
---

<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={socialImage ?? heroImage}
			alternatePath={alternatePath}
		/>
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.back {
				display: inline-block;
				margin-bottom: 2rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.back:hover {
				color: var(--accent);
			}
			.post-header {
				margin-bottom: 2.5rem;
			}
			.post-header h1 {
				margin: 0 0 0.6rem;
				font-size: clamp(2rem, 7vw, 2.6rem);
				line-height: 1.2;
				letter-spacing: -0.03em;
			}
			.post-header .meta {
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			.post-header .meta .sep {
				margin: 0 0.5em;
				opacity: 0.5;
			}
			.hero-image {
				margin-bottom: 2rem;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 10px;
			}
			.prose {
				color: rgb(var(--gray-dark));
			}
			.system-prose {
				font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
			}
			.prose :global(h2),
			.prose :global(h3),
			.prose :global(h4),
			.prose :global(h5),
			.prose :global(h6) {
				scroll-margin-top: 6rem;
			}
			.prose :global(h2) {
				margin-top: 2.25em;
				font-size: 1.65em;
			}
			.prose :global(h3) {
				margin-top: 1.9em;
				font-size: 1.3em;
			}
			.prose :global(h4) {
				margin-top: 1.7em;
				font-size: 1.08em;
			}
			.prose :global(p) {
				margin-bottom: 1.5em;
			}
			.prose :global(ul),
			.prose :global(ol) {
				margin: 0 0 1.5em;
				padding-left: 1.4em;
			}
			.prose :global(li + li) {
				margin-top: 0.35em;
			}
			.prose :global(a) {
				font-weight: 600;
			}
			.prose :global(pre.mermaid) {
				display: block;
				margin: 2rem 0;
				padding: 1rem;
				background: transparent;
				overflow-x: auto;
				white-space: pre-wrap;
			}
			.prose :global(pre.mermaid svg) {
				display: block;
				max-width: none !important;
				height: auto;
				margin-inline: auto;
			}
			.tag-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 3rem 0 0;
				padding: 0;
				list-style: none;
			}
			.tag {
				display: inline-block;
				padding: 0.35rem 0.8rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				font-size: 0.85rem;
				line-height: 1.4;
				color: rgb(var(--gray-dark));
				text-decoration: none;
				transition:
					color 160ms ease,
					border-color 160ms ease;
			}
			.tag:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			.tag:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}
			.tag::before {
				content: '#';
				margin-right: 0.15em;
				color: var(--accent);
			}
			.post-footer {
				margin-top: 3rem;
				padding-top: 2rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.series-box {
				margin-bottom: 2rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				font-size: 0.95rem;
			}
			.series-box summary {
				padding: 0.8rem 1rem;
				cursor: pointer;
				font-weight: 600;
				color: rgb(var(--gray-dark));
			}
			.series-box summary .series-tag {
				margin-right: 0.6em;
				font-size: 0.8rem;
				font-weight: 700;
				color: var(--accent);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.series-box summary .series-count {
				margin-left: 0.5em;
				font-weight: 400;
				color: rgb(var(--gray));
			}
			.series-box ol {
				margin: 0;
				padding: 0 1rem 0.9rem 2.4rem;
			}
			.series-box li {
				margin: 0.35rem 0;
				color: rgb(var(--gray));
			}
			.series-box li[aria-current='page'] {
				font-weight: 600;
				color: rgb(var(--gray-dark));
			}
			.series-box a {
				color: inherit;
				text-decoration: none;
			}
			.series-box a:hover {
				color: var(--accent);
			}
			.post-nav {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 2rem;
			}
			.post-nav-link {
				display: block;
				max-width: 48%;
				font-weight: 600;
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.post-nav-link:hover {
				color: var(--accent);
			}
			.post-nav-link .dir {
				display: block;
				margin-bottom: 0.25rem;
				font-size: 0.8rem;
				font-weight: 400;
				color: rgb(var(--gray));
			}
			.post-nav-link.next {
				margin-left: auto;
				text-align: right;
			}
			.related-posts {
				margin-top: 3rem;
				padding-top: 2rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.related-posts h2 {
				margin: 0 0 1.2rem;
				font-size: 1.2rem;
			}
			.related-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
				gap: 1.2rem;
			}
			.related-card {
				display: block;
				text-decoration: none;
			}
			.related-card :global(.related-thumb) {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 1200 / 630;
				object-fit: cover;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
			}
			.related-title {
				margin: 0.7rem 0 0.35rem;
				display: -webkit-box;
				overflow: hidden;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 2;
				font-size: 1.02rem;
				line-height: 1.4;
				color: rgb(var(--black));
				transition: color 0.2s ease;
			}
			.related-desc {
				margin: 0 0 0.45rem;
				display: -webkit-box;
				overflow: hidden;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 2;
				font-size: 0.88rem;
				line-height: 1.5;
				color: rgb(var(--gray-dark));
			}
			.related-date {
				margin: 0;
				font-size: 0.82rem;
				color: rgb(var(--gray));
			}
			.related-card:hover .related-title {
				color: var(--accent);
			}
			.related-card:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 4px;
				border-radius: 8px;
			}
			@media (max-width: 640px) {
				.post-nav {
					flex-direction: column;
				}
				.post-nav-link {
					max-width: 100%;
				}
				.post-nav-link.next {
					margin-left: 0;
					text-align: left;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<a class="back" href={backHref}>{backLabel}</a>
				<header class="post-header">
					<h1 data-pagefind-body>{title}</h1>
					<div class="meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<>
									<span class="sep">·</span>
									<span>
										{updatedLabel} <FormattedDate date={updatedDate} />
									</span>
								</>
							)
						}
					</div>
				</header>
				{
					nav?.series && (
						<details class="series-box" data-series={nav.series.name}>
							<summary>
								<span class="series-tag">{seriesLabel}</span>
								{nav.series.name}
								<span class="series-count">
									{nav.series.index}/{nav.series.posts.length}
								</span>
							</summary>
							<ol>
								{nav.series.posts.map((p) =>
									p.current ? (
										<li aria-current="page">{p.title}</li>
									) : (
										<li>
											<a href={p.href}>{p.title}</a>
										</li>
									),
								)}
							</ol>
						</details>
					)
				}
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" priority />
						</div>
					)
				}
				<div class:list={['prose', { 'system-prose': lang === 'ko' }]} data-pagefind-body>
					<slot />
				</div>
				{
					tags && tags.length > 0 && (
						<ul class="tag-list" aria-label={tagsLabel}>
							{tags.map((tag) => (
								<li>
									<a class="tag" href={`${backHref}/tags/${tagSlug(tag)}/`}>
										{tag}
									</a>
								</li>
							))}
						</ul>
					)
				}
				<div class="post-footer">
					{
						(nav?.prev || nav?.next) && (
							<nav class="post-nav" aria-label={postNavLabel}>
								{nav?.prev && (
									<a class="post-nav-link prev" href={nav.prev.href}>
										<span class="dir">{prevLabel}</span>
										{nav.prev.title}
									</a>
								)}
								{nav?.next && (
									<a class="post-nav-link next" href={nav.next.href}>
										<span class="dir">{nextLabel}</span>
										{nav.next.title}
									</a>
								)}
							</nav>
						)
					}
					<Giscus />
					{
						nav && nav.related.length > 0 && (
							<section class="related-posts">
								<h2>{relatedLabel}</h2>
								<div class="related-grid">
									{nav.related.map((p) => (
										<a class="related-card" href={`${backHref}/${p.id.replace(/^(en|ko)\//, '')}/`}>
											<Image
												class="related-thumb"
												src={p.data.heroImage ?? p.data.socialImage}
												alt=""
												width={400}
												height={210}
												loading="lazy"
											/>
											<h3 class="related-title">{p.data.title}</h3>
											<p class="related-desc">{p.data.description}</p>
											<p class="related-date">
												<FormattedDate date={p.data.pubDate} />
											</p>
										</a>
									))}
								</div>
							</section>
						)
					}
				</div>
			</article>
			<TableOfContents headings={headings} lang={lang} />
		</main>
		<Footer />

		<script>
			// 페이지를 이동해도 열어둔 시리즈 박스가 열린 채 유지되게 한다.
			const seriesBox = document.querySelector<HTMLDetailsElement>('.series-box');
			if (seriesBox) {
				const seriesKey = `series-open:${seriesBox.dataset.series ?? ''}`;
				try {
					if (sessionStorage.getItem(seriesKey)) seriesBox.open = true;
					seriesBox.addEventListener('toggle', () => {
						if (seriesBox.open) sessionStorage.setItem(seriesKey, '1');
						else sessionStorage.removeItem(seriesKey);
					});
				} catch {
					/* storage unavailable */
				}
			}

			const isKorean = document.documentElement.lang === 'ko';
			const copyText = isKorean ? '복사' : 'Copy';
			const copiedText = isKorean ? '복사됨' : 'Copied';
			const copyLabel = isKorean ? '코드 복사' : 'Copy code';
			const copiedLabel = isKorean ? '코드 복사됨' : 'Code copied';

			document.querySelectorAll<HTMLPreElement>('article pre').forEach((pre) => {
				if (pre.classList.contains('mermaid') || pre.parentElement?.classList.contains('code-block'))
					return;
				const wrapper = document.createElement('div');
				wrapper.className = 'code-block';
				pre.parentNode?.insertBefore(wrapper, pre);
				wrapper.appendChild(pre);

				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'copy-btn';
				btn.textContent = copyText;
				btn.setAttribute('aria-label', copyLabel);
				btn.setAttribute('aria-live', 'polite');
				btn.addEventListener('click', async () => {
					const code = pre.querySelector('code')?.innerText ?? pre.innerText;
					try {
						await navigator.clipboard.writeText(code);
						btn.textContent = copiedText;
						btn.setAttribute('aria-label', copiedLabel);
						btn.classList.add('copied');
						setTimeout(() => {
							btn.textContent = copyText;
							btn.setAttribute('aria-label', copyLabel);
							btn.classList.remove('copied');
						}, 1500);
					} catch {
						/* clipboard unavailable */
					}
				});
				wrapper.appendChild(btn);
			});

			const diagrams = Array.from(document.querySelectorAll<HTMLPreElement>('pre.mermaid'));
			if (diagrams.length > 0) {
				const sources = new Map(diagrams.map((diagram) => [diagram, diagram.textContent ?? '']));
				const renderedThemes = new Map<HTMLPreElement, boolean>();
				let mermaid: (typeof import('mermaid'))['default'] | undefined;
				let renderQueue = Promise.resolve();

				const renderDiagram = (diagram: HTMLPreElement) => {
					renderQueue = renderQueue.then(async () => {
						const darkMode = document.documentElement.classList.contains('dark');
						if (renderedThemes.get(diagram) === darkMode) return;

						mermaid ??= (await import('mermaid')).default;
						diagram.removeAttribute('data-processed');
						delete diagram.dataset.mermaidError;
						diagram.textContent = sources.get(diagram) ?? '';
						mermaid.initialize({
							startOnLoad: false,
							securityLevel: 'strict',
							theme: darkMode ? 'dark' : 'default',
						});
						await mermaid.run({ nodes: [diagram] });
						const svg = diagram.querySelector<SVGSVGElement>('svg');
						const naturalWidth = svg?.viewBox.baseVal.width;
						const naturalHeight = svg?.viewBox.baseVal.height;
						if (svg && naturalWidth) {
							const maxWidth = naturalHeight && naturalWidth > naturalHeight ? 960 : 680;
							svg.style.width = `${Math.min(naturalWidth, maxWidth)}px`;
							svg.style.maxWidth = 'none';
						}
						renderedThemes.set(diagram, darkMode);

						if (document.documentElement.classList.contains('dark') !== darkMode) {
							void renderDiagram(diagram);
						}
					}).catch((error) => {
						const message = error instanceof Error
							? `${error.name}: ${error.message}`
							: JSON.stringify(error) || String(error);
						console.error(`Unable to render Mermaid diagram. ${message}`);
						renderedThemes.delete(diagram);
						diagram.removeAttribute('data-processed');
						diagram.dataset.mermaidError = message;
						diagram.textContent = sources.get(diagram) ?? '';
					});
					return renderQueue;
				};

				if ('IntersectionObserver' in window) {
					const observer = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (!entry.isIntersecting) continue;
								observer.unobserve(entry.target);
								void renderDiagram(entry.target as HTMLPreElement);
							}
						},
						{ rootMargin: '300px' },
					);
					for (const diagram of diagrams) observer.observe(diagram);
				} else {
					for (const diagram of diagrams) void renderDiagram(diagram);
				}

				new MutationObserver(() => {
					for (const diagram of renderedThemes.keys()) void renderDiagram(diagram);
				}).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
			}
		</script>
	</body>
</html>
