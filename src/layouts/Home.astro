---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_DESCRIPTION_KO, SITE_TITLE } from '../consts';
import { getHomePage } from '../lib/home';
import { notesFeedInfo } from '../lib/notes';

interface Props {
	lang: 'en' | 'ko';
}

const { lang } = Astro.props;
const isKo = lang === 'ko';
const page = await getHomePage(lang);
const { copy } = page;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={isKo ? SITE_DESCRIPTION_KO : SITE_DESCRIPTION}
			alternatePath="/"
			additionalFeeds={[notesFeedInfo(lang)]}
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">{copy.eyebrow}</p>
				<h1>{copy.title}</h1>
				<p>{copy.intro}</p>
				<div class="actions">
					<a href={page.blogHref}>{copy.blog}</a>
					<a href={page.notesHref}>{copy.notes}</a>
					<a href={page.aboutHref}>{copy.about}</a>
				</div>
			</section>

			<div class:list={['guide', { 'system-copy': isKo }]}>
				<section class="block" aria-labelledby="start-here">
					<div class="section-head">
						<h2 id="start-here">{copy.startTitle}</h2>
					</div>
					<p class="lead">{copy.startLead}</p>
					<ul class="rows">
						{
							page.startHere.map((post) => (
								<li>
									<a href={post.href}>
										<span class="t">{post.title}</span>
										<span class="d">
											<FormattedDate date={post.date} />
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</section>

				<section class="block" id="topics" aria-labelledby="topics-title">
					<div class="section-head">
						<h2 id="topics-title">{copy.topicsTitle}</h2>
					</div>
					<p class="lead">{copy.topicsLead}</p>
					<div class="topics">
						{
							page.topics.map((topic) => (
								<section class="topic">
									<h3>{topic.title}</h3>
									<p>{topic.summary}</p>
									<p class="topic-path">
										<span class="count">{topic.countLabel}</span>
										<a href={topic.entry.href}>{topic.entry.label}</a>
									</p>
								</section>
							))
						}
					</div>
				</section>

				{
					page.recentPosts.length > 0 && (
						<section class="block" aria-labelledby="recent-posts">
							<div class="section-head">
								<h2 id="recent-posts">{copy.postsTitle}</h2>
								<a href={page.blogHref}>{copy.postsAll}</a>
							</div>
							<ul class="rows">
								{page.recentPosts.map((post) => (
									<li>
										<a href={post.href}>
											<span class="t">{post.title}</span>
											<span class="d">
												<FormattedDate date={post.date} />
											</span>
										</a>
									</li>
								))}
							</ul>
						</section>
					)
				}

				{
					page.notes.length > 0 && (
						<section class="block" aria-labelledby="recent-notes">
							<div class="section-head">
								<h2 id="recent-notes">{copy.notesTitle}</h2>
								<span class="section-links">
									<a href={page.notesHref}>{copy.notesIndex}</a>
									<a href={page.notesFeedHref}>{copy.notesRss}</a>
								</span>
							</div>
							<ul class="rows">
								{page.notes.map((note) => (
									<li>
										<a href={note.href}>
											<span class="t">{note.title}</span>
											<span class="d">
												<FormattedDate date={note.date} />
											</span>
										</a>
									</li>
								))}
							</ul>
						</section>
					)
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 1rem 0 2.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.hero .eyebrow {
		margin: 0 0 0.6rem;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.hero h1 {
		margin: 0 0 0.8rem;
		max-width: 40rem;
		font-size: clamp(2.15rem, 7vw, 2.6rem);
		line-height: 1.15;
		letter-spacing: -0.03em;
		text-wrap: balance;
		/* 한국어 제목이 "개 / 발"처럼 단어 중간에서 끊기지 않게 한다. */
		word-break: keep-all;
	}
	.hero p {
		margin: 0 0 1.4rem;
		font-size: 1.1rem;
		color: rgb(var(--gray-dark));
		max-width: 38rem;
	}
	.hero .actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.2rem;
	}
	.hero .actions a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0.25rem 0;
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
	}
	.hero .actions a::after {
		content: ' →';
		color: rgb(var(--gray));
	}

	/* 한국어 홈은 글 제목과 노트 문장이 많아 본문과 같이 시스템 산세리프를 쓴다. */
	.system-copy {
		font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
	}

	.block {
		margin-top: 2.5rem;
	}
	.section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin-bottom: 0.5rem;
	}
	.section-head h2 {
		margin: 0;
		font-size: 1.2rem;
		letter-spacing: -0.01em;
	}
	.section-head a,
	.section-links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: 0.85rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.section-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}
	.section-head a:hover,
	.section-links a:hover {
		color: var(--accent);
	}
	.lead {
		margin: 0 0 0.75rem;
		color: rgb(var(--gray-dark));
		font-size: 0.98rem;
	}

	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.rows li a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
		text-decoration: none;
	}
	.rows li .t {
		min-width: 0;
		color: rgb(var(--black));
		font-weight: 500;
		line-height: 1.45;
		transition: color 0.2s ease;
	}
	.rows li a:hover .t {
		color: var(--accent);
	}
	.rows li .d {
		flex-shrink: 0;
		font-size: 0.82rem;
		color: rgb(var(--gray));
	}

	/* 주제는 연재 글을 펼치지 않는다. 글 순서는 각 글 상단의 시리즈 상자가 보여 준다. */
	.topic {
		padding: 0.6rem 0 0.2rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.topic h3 {
		margin: 0.4rem 0 0.45rem;
		font-size: 1.05rem;
	}
	.topic > p {
		margin: 0 0 0.35rem;
		color: rgb(var(--gray-dark));
		font-size: 0.95rem;
	}
	.topic-path {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 1rem;
		margin: 0.15rem 0 0.2rem;
	}
	.topic-path .count {
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	.topic-path a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: 0.92rem;
		font-weight: 600;
		text-decoration: none;
	}
	.topic-path a::after {
		content: ' →';
		color: rgb(var(--gray));
	}

	a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
		border-radius: 4px;
	}

	@media (max-width: 520px) {
		.hero {
			padding: 0.5rem 0 2rem;
		}
		.hero p {
			font-size: 1rem;
		}
		.block {
			margin-top: 2rem;
		}
		.rows li a {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.15rem;
			padding: 1rem 0;
		}
	}
</style>
