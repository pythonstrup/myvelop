---
import { render } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import {
	type Note,
	getBacklinks,
	getNotes,
	noteDescription,
	noteHref,
	noteTitle,
} from '../../../lib/notes';

export async function getStaticPaths() {
	return (await getNotes()).map((note) => ({
		params: { slug: note.id.replace(/^ko\//, '') },
		props: note,
	}));
}
type Props = Note;

const note = Astro.props;
const { Content } = await render(note);
const title = noteTitle(note);
const backlinks = getBacklinks(note, await getNotes());
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={noteDescription(note)} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.back {
				display: inline-block;
				margin-bottom: 2rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.back:hover {
				color: var(--accent);
			}
			h1 {
				margin: 0 0 2rem;
				font-size: clamp(1.6rem, 5.5vw, 2.1rem);
				line-height: 1.3;
				letter-spacing: -0.02em;
			}
			.prose {
				color: rgb(var(--gray-dark));
				font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
			}
			.prose :global(p) {
				margin-bottom: 1.5em;
			}
			.prose :global(a) {
				font-weight: 600;
			}
			.backlinks {
				margin-top: 3rem;
				padding-top: 2rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.backlinks h2 {
				margin: 0 0 1rem;
				font-size: 1.1rem;
			}
			.backlinks ul {
				margin: 0;
				padding-left: 1.2em;
			}
			.backlinks li + li {
				margin-top: 0.5rem;
			}
			.backlinks a {
				font-weight: 600;
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.backlinks a:hover {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<a class="back" href="/ko/notes/">← 색인으로</a>
				<h1 data-pagefind-body>{title}</h1>
				<div class="prose" data-pagefind-body>
					<Content />
				</div>
				{
					backlinks.length > 0 && (
						<section class="backlinks">
							<h2>이 노트를 참조하는 노트</h2>
							<ul>
								{backlinks.map((other) => (
									<li>
										<a href={noteHref(other)}>{noteTitle(other)}</a>
									</li>
								))}
							</ul>
						</section>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>
