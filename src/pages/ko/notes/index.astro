---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
// 손으로 쓰는 색인 노트. 키워드마다 진입 노트 한둘만 가리킨다. 규칙은 src/content/notes/README.md에 있다.
import * as indexNote from '../../../content/notes/index.md';

const { Content } = indexNote;
const hasEntries = indexNote.rawContent().replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
const description =
	'제텔카스텐 색인입니다. 키워드마다 진입 노트 한둘만 가리키고, 그다음은 노트 안의 링크를 따라갑니다.';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`노트 · ${SITE_TITLE}`} description={description} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.lead {
				margin: 0 0 2.5rem;
				color: rgb(var(--gray));
			}
			.index {
				color: rgb(var(--gray-dark));
				font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
			}
			.index :global(ul) {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.index :global(li) {
				padding: 0.7rem 0;
				line-height: 1.6;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.index :global(a) {
				font-weight: 600;
			}
			.index :global(h2) {
				margin: 2.2rem 0 0.4rem;
				font-size: 1.05rem;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>노트</h1>
			<p class="lead">{description}</p>
			{
				hasEntries ? (
					<div class="index">
						<Content />
					</div>
				) : (
					<p>아직 색인에 올린 노트가 없습니다.</p>
				)
			}
		</main>
		<Footer />
	</body>
</html>
