---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	lang: 'en' | 'ko';
}

const { posts, lang } = Astro.props;
const basePath = lang === 'ko' ? '/ko/blog' : '/blog';
---

<ul class="post-list">
	{
		posts.map((post) => (
			<li class="post-item">
				<a href={`${basePath}/${post.id.replace(`${lang}/`, '')}/`}>
					<Image
						class="thumb"
						src={post.data.heroImage ?? post.data.socialImage}
						alt=""
						width={320}
						height={168}
						loading="lazy"
					/>
					<div class="post-text">
						<h2 class="title">{post.data.title}</h2>
						<p class="date">
							<FormattedDate date={post.data.pubDate} />
						</p>
						<p class="desc">{post.data.description}</p>
					</div>
				</a>
			</li>
		))
	}
</ul>

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-item {
		padding: 1.75rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.post-item:first-child {
		padding-top: 0.5rem;
	}
	.post-item a {
		display: flex;
		gap: 1.1rem;
		align-items: flex-start;
		text-decoration: none;
	}
	.post-item .thumb {
		flex: none;
		width: 160px;
		height: auto;
		/* OG 카드 비율에 맞춰 고정한다. 본문 스크린샷처럼 비율이 다른
		   이미지도 목록에서는 같은 크기로 보이게 잘라낸다. */
		aspect-ratio: 1200 / 630;
		object-fit: cover;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
	}
	.post-item .post-text {
		min-width: 0;
	}
	.post-item .title {
		margin: 0 0 0.3rem;
		font-size: 1.5rem;
		color: rgb(var(--black));
		transition: color 0.2s ease;
	}
	.post-item .date {
		margin: 0 0 0.6rem;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}
	.post-item .desc {
		margin: 0;
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		font-size: 1rem;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
	}
	.post-item a:hover .title {
		color: var(--accent);
	}
	.post-item a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 6px;
		border-radius: 4px;
	}
	@media (max-width: 520px) {
		.post-item {
			padding: 1.4rem 0;
		}
		.post-item a {
			gap: 0.85rem;
		}
		.post-item .thumb {
			width: 96px;
		}
		.post-item .title {
			font-size: 1.35rem;
			line-height: 1.35;
		}
		.post-item .desc {
			font-size: 0.95rem;
			-webkit-line-clamp: 3;
		}
	}
</style>
